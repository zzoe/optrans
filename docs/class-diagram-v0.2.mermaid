classDiagram
    direction TB

    class FormatInfo {
        +FrameType frame_type
        +u16 frame_sequence
        +u32 block_index
        +u32 total_blocks
        +u16 payload_bytes
        +FrameKind frame_kind
        +u8 encoding_mode_bit
        --
        +new_meta(seq, total, payload_len) FormatInfo
        +new_data(seq, block_idx, total, payload_len) FormatInfo
        +new_eot(seq) FormatInfo
        +encoding_mode() EncodingMode
    }

    class FrameKind {
        <<enumeration>>
        I = 0
        P = 1
    }

    class EncodingMode {
        <<enumeration>>
        Auto
        Binary
        Gray(u32)
    }

    class GrayEncodingConfig {
        +u32 levels
        +Vec~u8~ gray_table
        +Vec~u8~ thresholds
        --
        +new(levels: u32) GrayEncodingConfig
        +classify(luminance: u8) u8
        +encode(data: &[u8]) Vec~u8~
        +decode(gray_values: &[u8], original_len: usize) Vec~u8~
    }

    class Frame {
        +FormatInfo format_info
        +Vec~u8~ encoded_payload
        +FrameKind frame_kind
        --
        +new_metadata(manifest, seq) Frame
        +new_data(block, seq, total) Frame
        +new_p_frame(entries, seq, base_seq) Frame
        +new_eot(seq) Frame
        +frame_type() FrameType
        +sequence() u16
    }

    class DiffEntry {
        +u16 module_index
        +u8 module_value
    }

    class SenderCache {
        +Vec~u8~ i_frame_modules
        +u16 i_frame_seq
        --
        +update(seq, modules)
        +compute_diff(current: &[u8]) Vec~DiffEntry~
    }

    class DecodedFrame {
        +FrameType frame_type
        +u16 frame_sequence
        +u32 block_index
        +u32 total_blocks
        +Vec~u8~ payload
        +FrameKind frame_kind
        +EncodingMode encoding_mode
        +Option~u16~ base_frame_seq
    }

    class ReceiverCache {
        +Vec~u8~ i_frame_modules
        +u16 i_frame_seq
        --
        +check_base(seq: u16) bool
        +merge(entries: &[DiffEntry]) Vec~u8~
    }

    class SendArgs {
        +PathBuf path
        +u32 module_pixels
        +u32 rounds
        +u64 interval_ms
        +u32 gray_levels
        +bool enable_diff
        +bool enable_heartbeat
        +u32 i_frame_interval
    }

    class ReceiveArgs {
        +PathBuf output
        +u32 module_pixels
        +u64 timeout_secs
        +EncodingMode encoding_mode
    }

    FormatInfo --> FrameKind : frame_kind
    FormatInfo --> EncodingMode : encoding_mode_bit →
    Frame --> FormatInfo : format_info
    Frame --> FrameKind : frame_kind
    DecodedFrame --> FrameKind
    DecodedFrame --> EncodingMode
    SendArgs --> GrayEncodingConfig : creates
    SenderCache --> DiffEntry : produces
    ReceiverCache --> DiffEntry : consumes
    GrayEncodingConfig --> EncodingMode : matches level
