classDiagram
    direction TB

    %% ── Enums ──
    class FrameType {
        <<enumeration>>
        Metadata = 0
        Data = 1
        EndOfTransmission = 2
    }

    class IngestResult {
        <<enumeration>>
        NewMeta
        NewData(u32)
        EotReceived
        Duplicate
        Invalid
    }

    %% ── Common Types ──
    class FormatInfo {
        +frame_type: FrameType
        +frame_sequence: u16
        +block_index: u32
        +total_blocks: u32
        +payload_bytes: u16
    }

    class MetaPayload {
        +file_name_len: u16
        +file_name: Vec~u8~
        +file_size: u64
        +sha256: [u8; 32]
        +block_size: u32
        +total_blocks: u32
    }

    class BlockData {
        +index: u32
        +data: Vec~u8~
    }

    %% ── Encoder Types ──
    class Frame {
        +format_info: FormatInfo
        +payload: Vec~u8~
        +modules_per_side: u32
        +new_metadata(manifest: FileManifest, seq: u16) Result~Frame~
        +new_data(block: BlockData, seq: u16, total: u32) Result~Frame~
        +new_eot(seq: u16) Result~Frame~
    }

    %% ── Sender Types ──
    class FileManifest {
        +path: PathBuf
        +file_name: String
        +file_size: u64
        +sha256: [u8; 32]
        +blocks: Vec~BlockData~
    }

    class SenderWindow {
        -hwnd: HWND
        -width: i32
        -height: i32
        -bitmap_buffer: Vec~u8~
        +create(w: i32, h: i32) Result~Self~
        +update_bitmap(pixels: &[u8])
        +show(&mut self)
        +process_messages() bool
    }

    class SendArgs {
        +path: PathBuf
        +module_pixels: u32
        +modules_per_side: u32
        +rounds: u32
        +frame_interval_ms: u64
    }

    %% ── Decoder Types ──
    class FinderPattern {
        +center: (f64, f64)
        +module_size: f64
    }

    class FrameLocation {
        +tl: FinderPattern
        +tr: FinderPattern
        +bl: FinderPattern
        +modules_per_side: u32
    }

    class DecodedFrame {
        +frame_type: FrameType
        +seq: u16
        +block_index: u32
        +total_blocks: u32
        +payload: Vec~u8~
    }

    %% ── Receiver Types ──
    class FrameCollector {
        -seen_seqs: HashSet~u16~
        -meta: Option~MetaPayload~
        -data_blocks: HashMap~u32, Vec~u8~~
        -total_blocks: u32
        +new() Self
        +ingest(frame: DecodedFrame) Result~IngestResult~
        +is_complete() bool
        +missing_blocks() Vec~u32~
    }

    class FileAssembler {
        -meta: MetaPayload
        -blocks: HashMap~u32, Vec~u8~~
        +new(meta: MetaPayload) Self
        +add_block(index: u32, data: Vec~u8~)
        +finalize(self) Result~Vec~u8~~
    }

    class ReceiveArgs {
        +output: PathBuf
        +capture_x: i32
        +capture_y: i32
        +capture_w: i32
        +capture_h: i32
        +timeout_secs: u64
    }

    %% ── Error Type ──
    class OptransError {
        <<enumeration>>
        Io
        Win32
        FrameDecode
        RsDecode
        ChecksumMismatch
        IncompleteTransfer
        InvalidFormatInfo
        NoFrameFound
        Timeout
    }

    %% ── Relationships ──
    FormatInfo --> FrameType : uses
    DecodedFrame --> FrameType : uses
    IngestResult --> FrameType : references

    Frame *-- FormatInfo
    Frame ..> BlockData : consumes

    FileManifest *-- BlockData
    FileManifest ..> MetaPayload : produces

    FrameLocation *-- FinderPattern

    DecodedFrame *-- FormatInfo

    FrameCollector --> MetaPayload : stores
    FrameCollector --> DecodedFrame : ingests
    FrameCollector --> IngestResult : returns

    FileAssembler --> MetaPayload : references
    FileAssembler ..> FileManifest : validates against

    SenderWindow ..> Frame : displays
    SendArgs ..> SenderWindow : configures

    ReceiveArgs ..> FrameCollector : configures
    FrameCollector ..> FileAssembler : feeds
