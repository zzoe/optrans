sequenceDiagram
    actor User
    participant CLI as cli.rs
    participant Send as sender/transmit
    participant Chunker as sender/chunker
    participant Frame as encoder/frame
    participant RSEnc as encoder/reed_solomon
    participant Render as encoder/render
    participant Window as sender/window
    participant Win32 as win32/ffi

    rect rgb(240, 248, 255)
        Note over User, Win32: ===== 发送流程 (optrans send) =====
    end

    User ->> CLI: optrans send ./file.bin
    CLI ->> Send: run_send(args)

    Send ->> Chunker: read_file("./file.bin")
    Chunker ->> Chunker: fs::read() → bytes
    Chunker ->> Chunker: sha2::Sha256::digest(bytes)
    Chunker ->> Chunker: 按4096分块 → Vec<BlockData>
    Chunker -->> Send: FileManifest { blocks[N], sha256, ... }

    Send ->> Frame: new_metadata(manifest, seq=0)
    Frame ->> RSEnc: rs_encode(meta_payload)
    RSEnc -->> Frame: encoded_payload
    Frame -->> Send: metadata_frame

    Send ->> Window: create(800, 800)
    Window ->> Win32: RegisterClassExW()
    Window ->> Win32: CreateWindowExW(WS_EX_TOPMOST)
    Win32 -->> Window: HWND
    Window -->> Send: SenderWindow

    loop rounds × N blocks
        alt 元数据帧 (首轮首帧)
            Send ->> Render: render_frame(metadata_frame)
        else 数据帧
            Send ->> Frame: new_data(block[i], seq, total)
            Frame ->> RSEnc: rs_encode(block_payload)
            RSEnc -->> Frame: encoded_payload
            Frame -->> Send: data_frame
            Send ->> Render: render_frame(data_frame)
        end
        Render ->> Render: 遍历模块→像素缓冲区 (RGBA)
        Render -->> Send: Vec<u8> pixels
        Send ->> Window: update_bitmap(pixels)
        Window ->> Win32: SetDIBitsToDevice() → WM_PAINT
        Send ->> Send: sleep(frame_interval_ms)
    end

    loop EOT_REPEAT 次
        Send ->> Frame: new_eot(seq++)
        Frame -->> Send: eot_frame
        Send ->> Render: render_frame(eot_frame)
        Render -->> Send: pixels
        Send ->> Window: update_bitmap(pixels)
        Send ->> Send: sleep(frame_interval_ms)
    end

    Note over Window: 等待用户按 ESC 退出
    Send ->> Window: destroy()

    rect rgb(255, 248, 240)
        Note over User, Win32: ===== 接收流程 (optrans receive) =====
    end

    actor Receiver as receiver/mod
    participant Capture as receiver/capture
    participant Locate as decoder/locate
    participant Extract as decoder/extract
    participant Decode as decoder/decode
    participant RSDec as decoder/reed_solomon
    participant Collect as receiver/collect
    participant Reasm as receiver/reassemble

    User ->> CLI: optrans receive ./out.bin
    CLI ->> Receiver: run_receive(args)

    Receiver ->> Collect: FrameCollector::new()
    Collect -->> Receiver: collector

    loop 直到 EOT 或超时
        Receiver ->> Capture: capture_screen(0, 0, 800, 800)
        Capture ->> Win32: GetDC(NULL) → screen DC
        Capture ->> Win32: CreateCompatibleDC() → mem DC
        Capture ->> Win32: CreateCompatibleBitmap()
        Capture ->> Win32: BitBlt(SRCCOPY) → 拷贝屏幕
        Capture ->> Win32: GetDIBits() → RGBA pixels
        Capture ->> Win32: DeleteDC + ReleaseDC
        Capture -->> Receiver: (pixels, 800, 800)

        Receiver ->> Locate: locate_frame(pixels, w, h)
        activate Locate
        Locate ->> Locate: 水平扫描找 1:1:3:1:1 比例
        Locate ->> Locate: 垂直交叉验证
        Locate ->> Locate: 三中心几何约束验证
        alt 定位成功
            Locate -->> Receiver: Some(FrameLocation)
        else 定位失败
            Locate -->> Receiver: None → continue
        end
        deactivate Locate

        Receiver ->> Extract: extract_format_modules(pixels, loc)
        Extract ->> Extract: 通过仿射变换采样格式信息区 372 bits
        Extract -->> Receiver: format_bits

        Receiver ->> Decode: decode_format_info(format_bits)
        Decode ->> Decode: 三重重复投票 + CRC-16 校验
        Decode -->> Receiver: FormatInfo

        Receiver ->> Collect: ingest(frame)
        activate Collect
        Collect ->> Collect: 检查 seen_seqs → 去重

        alt FrameType::Metadata
            Collect ->> Extract: extract_data_modules(pixels, loc)
            Extract -->> Collect: data_bits
            Collect ->> Decode: decode_payload(data_bits)
            Decode ->> RSDec: rs_decode_data(encoded)
            RSDec -->> Decode: meta_payload bytes
            Decode -->> Collect: MetaPayload
            Collect ->> Reasm: FileAssembler::new(meta)
            Reasm -->> Collect: assembler
            Collect -->> Receiver: IngestResult::NewMeta

        else FrameType::Data
            Collect ->> Extract: extract_data_modules(pixels, loc)
            Extract -->> Collect: data_bits
            Collect ->> Decode: decode_payload(data_bits)
            Decode ->> RSDec: rs_decode_data(encoded)
            RSDec -->> Decode: block_data bytes
            Decode -->> Collect: (block_index, data)
            Collect ->> Reasm: add_block(index, data)
            Collect -->> Receiver: IngestResult::NewData(index)

        else FrameType::EndOfTransmission
            Collect ->> Collect: is_complete()?
            alt 完整
                Collect -->> Receiver: IngestResult::EotReceived → break
            else 不完整
                Collect -->> Receiver: IngestResult::EotReceived → continue
            end
        end
        deactivate Collect

        Receiver ->> Receiver: 超时检查 → break if timeout
    end

    Receiver ->> Reasm: finalize()
    activate Reasm
    Reasm ->> Reasm: 按 index 排序拼接所有块
    Reasm ->> Reasm: sha2::Sha256::digest(assembled)
    Reasm ->> Reasm: 与 MetaPayload.sha256 比对
    alt SHA-256 匹配
        Reasm -->> Receiver: Ok(file_bytes)
    else SHA-256 不匹配
        Reasm -->> Receiver: Err(ChecksumMismatch)
    end
    deactivate Reasm

    Receiver ->> Receiver: fs::write(out_path, file_bytes)
    Receiver -->> CLI: Ok(())
