sequenceDiagram
    participant CLI as CLI (main)
    participant TX as transmit.rs
    participant Chunker as chunker.rs
    participant Frame as frame.rs
    participant Render as render.rs
    participant Window as window.rs
    participant Capture as capture.rs
    participant Locate as locate.rs
    participant Extract as extract.rs
    participant Decode as decode.rs
    participant Collect as collect.rs
    participant Reasm as reassemble.rs

    Note over CLI,Reasm: === optrans v0.2 发送流程 (灰度 + I/P 帧 + 心跳) ===

    CLI->>TX: run_send(SendArgs { gray_levels: 5, enable_diff: true, enable_heartbeat: true })
    TX->>Chunker: read_file(path) → FileManifest
    Chunker-->>TX: manifest (blocks, sha256)
    
    TX->>TX: SenderCache { i_frame_modules: vec![], i_frame_seq: 0 }
    TX->>TX: GrayEncodingConfig::new(5)
    
    TX->>Window: SenderWindow::create(w, h)
    
    Note over TX: === 第1轮: 元数据帧 (始终I帧) ===
    TX->>Frame: Frame::new_metadata(manifest, seq=0, frame_kind=I, encoding_mode_bit=1)
    Frame->>Frame: RS encode payload
    Frame-->>TX: meta_frame (I)
    TX->>Render: render_frame(meta_frame, ..., gray_config, heartbeat=true)
    Render->>Render: render finder pattern (二值)
    Render->>Render: encode format_info (reserved: frame_kind=0, encoding=1)
    Render->>Render: render data modules (灰度值序列)
    Render->>Render: inject_heartbeat(pixels, seq=0) → 右下2×2=128
    Render-->>TX: pixel buffer RGBA
    TX->>Window: update_bitmap(pixels)
    TX->>Window: sleep_with_messages(150ms)
    
    Note over TX: === 数据帧循环 ===
    loop for each block
        TX->>TX: encode_block_to_gray5(block.data) → gray_values
        
        TX->>TX: decide_frame_kind(seq, idx, p_count, interval, diff_ratio)
        alt I-frame
            TX->>Frame: Frame::new_data(block, seq, total, frame_kind=I)
            Frame-->>TX: data_frame (I)
            TX->>TX: cache.i_frame_modules = full_gray_values
            TX->>TX: cache.i_frame_seq = seq
            TX->>TX: p_frame_count = 0
            TX->>Render: render_frame(frame, ..., gray_config) → 全量渲染
        else P-frame
            TX->>TX: diff_entries = compute_diff(gray_values, cache)
            TX->>Frame: Frame::new_p_frame(diff_entries, seq, cache.i_frame_seq)
            Frame->>Frame: payload = [base_frame_seq:2B] + [count:2B] + [entries: 2B+1B × N]
            Frame->>Frame: RS encode
            Frame-->>TX: p_frame (P)
            TX->>TX: p_frame_count += 1
            TX->>Render: render_frame(p_frame, ..., frame_kind=P, gray_config)
            Render->>Render: finder pattern (二值, 同I帧)
            Render->>Render: format_info (二值, 同I帧)
            Render->>Render: data区域填128中灰背景
            Render->>Render: 仅渲染 diff_entries 中的模块
        end
        
        Render->>Render: if heartbeat: inject_heartbeat(pixels, seq)
        Render-->>TX: pixel buffer
        TX->>Window: update_bitmap(pixels)
    end
    
    Note over TX: === EOT帧 ===
    TX->>Frame: Frame::new_eot(seq, frame_kind=I)
    TX->>Render: render_frame(eot_frame, ...)
    TX->>Window: update_bitmap(pixels) × EOT_REPEAT

    Note over CLI,Reasm: === optrans v0.2 接收流程 (灰度采样 + P帧合并) ===

    CLI->>Collect: run_receive(ReceiveArgs { encoding_mode: Auto })

    loop 截屏循环
        Collect->>Capture: capture_screen(x, y, w, h)
        Capture-->>Collect: (pixels, w, h)
        
        Collect->>Locate: locate_frame(pixels, w, h)
        Locate->>Locate: 水平扫描 1:1:3:1:1
        Locate->>Locate: 垂直验证 + 三中心几何约束
        Locate-->>Collect: FrameLocation { tl, tr, bl, n }

        Collect->>Decode: decode_frame(pixels, w, h, loc, encoding_mode)
        
        Decode->>Extract: extract_format_modules(pixels, w, h, loc)
        Extract-->>Decode: 372 format bits
        Decode->>Decode: 三重投票 + CRC-16 → FormatInfo
        Decode->>Decode: detect_encoding_mode(format_info):
        Note over Decode: reserved bit1=0 → Binary<br/>reserved bit1=1 → Gray(5)

        alt Binary mode
            Decode->>Extract: extract_data_modules(pixels, w, h, loc, bits, mode=Binary)
            Extract->>Extract: 3×3 均值采样, 阈值128二分
            Extract-->>Decode: data bits
        else Gray mode
            Decode->>Extract: extract_data_modules(pixels, w, h, loc, bits, mode=Gray(5))
            Extract->>Extract: 5×5 中值采样 → 亮度中值
            Extract->>Extract: classify_gray5(中值) → digit (0-4)
            Extract-->>Decode: gray values (per module)
        end

        alt frame_kind == I
            Decode->>Decode: gray values → decode_gray_5() → bytes
            Decode->>Decode: RS decode → payload
            Decode-->>Collect: DecodedFrame { frame_kind=I, payload, ... }
            Collect->>Collect: cache_i_frame(seq, data_modules)
            Collect->>Collect: ingest(payload) → NewBlock/NewMeta
        else frame_kind == P
            Decode->>Decode: parse P-frame payload:
            Note over Decode: [base_frame_seq:2B][count:2B][entries...]
            Decode-->>Collect: DecodedFrame { frame_kind=P, base_frame_seq, diff_entries, ... }
            
            Collect->>Collect: check_base_frame(base_frame_seq)
            alt cache missing or seq mismatch
                Collect->>Collect: discard P-frame (log warning)
            else cache matches
                Collect->>Collect: merge_p_frame(diff_entries)
                Note over Collect: merged = cache.i_frame_modules.clone()<br/>for entry in diff_entries:<br/>  merged[entry.module_index] = entry.module_value
                Collect->>Collect: decode_gray_5(merged) → bytes → RS decode → payload
                Collect->>Collect: ingest(payload) → NewBlock
            end
        end

        alt EOT + complete
            Collect->>Collect: break loop
        end
    end

    Collect->>Reasm: FileAssembler::new(meta)
    Collect->>Reasm: add_block(idx, data) for all blocks
    Reasm->>Reasm: sort → concat → SHA-256 verify
    Reasm-->>CLI: write output file
